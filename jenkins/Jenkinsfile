pipeline {
    agent { label 'rocky-vm3' }
    stages {
        stage('build') { 
            steps { 
                // Compiles and packages the WAR without running tests yet
                sh 'mvn clean package -DskipTests' 
            } 
        }
        stage('test') { 
            parallel {
                stage('test A') { steps { sh 'mvn test'; echo 'This is test A' } }
                stage('test B') { steps { sh 'mvn test'; echo 'This is test B' } }
    }
        }
        stage('deploy') { 
            steps { 
                // Example placeholder: actual deployment logic goes here
                sh 'echo "Deploying the jar file..."' 
            } 
        }
    }
    post {
        success {
            archiveArtifacts artifacts: '**/target/*.jar'
        }
    }
}
