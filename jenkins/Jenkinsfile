pipeline {
    agent {label 'rocky-vm3'}
    stages {
        stage('build')  { steps { sh 'mvn clean package' } }
        stage('test')   { steps { sh 'mvn clean package' } }
        stage('deploy') { steps { sh 'mvn clean package' } }
    }
    post {
        success {
            archieveArtifacts artifacts: '**/target/*.war'
        }
    }
}
