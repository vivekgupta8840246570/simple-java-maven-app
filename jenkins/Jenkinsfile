pipeline {
    agent { label 'rocky-vm3' }
    stages {
        stage('build') { 
            steps { 
                // Compiles and packages the WAR without running tests yet
                sh 'mvn clean package -DskipTests' 
            } 
        }
        stage('test') { 
            steps { 
                // Runs the tests against the compiled code
                sh 'mvn test' 
            } 
        }
        stage('deploy') { 
            steps { 
                // Example placeholder: actual deployment logic goes here
                sh 'echo "Deploying the WAR file..."' 
            } 
        }
    }
    post {
        success {
            archiveArtifacts artifacts: '**/target/*.war'
        }
    }
}
